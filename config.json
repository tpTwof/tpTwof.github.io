    "indexStyle": "<style>.profile-section{margin-bottom:32px;padding:28px 32px;background:#f5f5f7;border-radius:16px;}.profile-avatar{display:none;}.profile-info{display:flex;flex-direction:column;gap:8px;}.profile-name{font-size:28px;font-weight:600;letter-spacing:0;margin:0;color:#1d1d1f;}.profile-bio{font-size:16px;color:#333;margin:0;}.profile-desc{font-size:14px;color:#7a7a7a;margin:4px 0 0;}.profile-links{display:flex;gap:12px;margin-top:16px;}.profile-links a{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:#0066cc;color:#fff;border-radius:9999px;font-size:14px;transition:all 0.2s;}.profile-links a:hover{background:#0071e3;text-decoration:none;}.profile-links a.secondary{background:transparent;color:#0066cc;border:1px solid #0066cc;}.profile-links a.secondary:hover{background:#f0f0f0;}.main-layout{display:flex;flex-direction:column;gap:24px;}.main-content{width:100%;}.section-title{font-size:24px;font-weight:600;letter-spacing:0;margin:0 0 20px 0;color:#1d1d1f;}@media (max-width:768px){.main-area{padding:0 20px;}#header{padding:20px 0 16px;margin-bottom:20px;}.profile-section{padding:20px 24px;}.profile-name{font-size:22px;}.section-title{font-size:20px;}}.post-section{margin-bottom:32px;}.post-section .SideNav{border:1px solid #e0e0e0;border-radius:18px;overflow:hidden;}.post-section .SideNav-item{display:block;padding:16px 20px;border-bottom:1px solid #f0f0f0;transition:background-color 0.2s;text-decoration:none;}.post-section .SideNav-item:hover{background-color:#f5f5f7;text-decoration:none;}.post-section .SideNav-item:last-child{border-bottom:none;}.post-item-content{display:flex;flex-direction:column;gap:8px;}.post-item-content .listTitle{font-size:17px;font-weight:600;color:#1d1d1f;}.post-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}.post-meta .Label{border-radius:9999px;padding:2px 10px;font-size:12px;font-weight:500;}.post-meta .LabelTime{font-size:12px;color:#7a7a7a;}</style>",
