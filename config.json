    "style": "<style>body{box-sizing:border-box;min-width:200px;margin:0;font-size:17px;font-family:'SF Pro Text','Inter','Helvetica Neue',system-ui,-apple-system,sans-serif;line-height:1.47;color:#1d1d1f;letter-spacing:-0.374px;-webkit-font-smoothing:antialiased;}.layout-wrapper{display:flex;min-height:100vh;}.left-sidebar{position:fixed;top:0;left:0;width:220px;height:100vh;background:#f5f5f7;border-right:1px solid #e0e0e0;display:flex;flex-direction:column;z-index:100;}.sidebar-header{padding:28px 24px 20px;border-bottom:1px solid #e0e0e0;}.sidebar-avatar{width:48px;height:48px;border-radius:12px;object-fit:cover;margin-bottom:12px;display:block;}.sidebar-title{font-size:16px;font-weight:600;color:#1d1d1f;margin:0;letter-spacing:0;}.sidebar-subtitle{font-size:12px;color:#7a7a7a;margin:4px 0 0;}.sidebar-nav{flex:1;padding:16px 12px;}.nav-item{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:10px;color:#333;font-size:14px;font-weight:400;cursor:pointer;transition:all 0.15s;margin-bottom:4px;text-decoration:none;}.nav-item:hover{background:#e8e8ed;color:#1d1d1f;text-decoration:none;}.nav-item.active{background:#0066cc;color:#fff;font-weight:500;}.nav-item svg,.nav-item img{width:20px;height:20px;flex-shrink:0;}.nav-item span{font-size:14px;}.sidebar-footer{padding:20px 24px;border-top:1px solid #e0e0e0;}.sidebar-footer-text{font-size:11px;color:#7a7a7a;text-align:center;line-height:1.5;}.main-area{margin-left:220px;flex:1;padding:0 48px;max-width:100%;}#header{display:flex;padding:32px 0 24px;border-bottom:1px solid #e0e0e0;margin-bottom:32px;gap:16px;}#header .header-left{display:flex;align-items:center;gap:12px;}#header .header-right{margin-left:auto;display:flex;align-items:center;gap:8px;}#header .blog-title{font-size:24px;font-weight:600;letter-spacing:0;}#header .blog-subtitle{font-size:14px;color:#7a7a7a;margin-left:12px;}#footer{margin:48px 0 32px;text-align:center;font-size:12px;color:#7a7a7a;padding:24px 0;}a{color:#0066cc;text-deco